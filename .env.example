# ═══════════════════════════════════════════════════════════════════════════════
# JALRAKSHAK / FLASH FLOOD INTELLIGENCE — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Service Settings
ENVIRONMENT=development
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Authentication & Security
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-key-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-admin-password-securely

# Rate Limiting (SlowAPI)
DEFAULT_RATE_LIMIT=60/minute

# Persistence & Cache
DATABASE_URL=sqlite+aiosqlite:///./jalrakshak.db
# For production TimescaleDB: postgresql+asyncpg://postgres:postgres@localhost:5432/jalrakshak
REDIS_URL=redis://localhost:6379/0

# External Public APIs (All free / unauthenticated or official feeds)
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3/events

# Alerting / Dispatch (Apprise URIs, comma-separated e.g. mailto://, tgram://, json://)
APPRISE_TARGETS=

# Optional AI / Citizen Assistant (Set key to enable real inference; never fake it)
GEMINI_API_KEY=
